{
  "name": "tuirss",
  "version": "0.1.0",
  "description": "A terminal-based FreshRSS client with Reeder-inspired UX",
  "module": "src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --outdir ./dist",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .husky"
  },
  "keywords": ["rss", "freshrss", "tui", "terminal", "reader"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.2.2",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  }
}
