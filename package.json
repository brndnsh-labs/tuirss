{
  "name": "tuirss",
  "version": "0.1.0",
  "description": "A terminal-based FreshRSS client with Reeder-inspired UX",
  "module": "src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --outdir ./dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --import-plugin",
    "lint:fix": "oxlint . --import-plugin --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "prepare": "git config core.hooksPath .husky"
  },
  "keywords": ["rss", "freshrss", "tui", "terminal", "reader"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@opentui/core": "^0.2.2",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  }
}
